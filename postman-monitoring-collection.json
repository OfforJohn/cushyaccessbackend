    {
      "name": "Alerts",
      "item": [
        {
          "name": "Get All Alerts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/alerts?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "alerts"],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of alerts to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of alerts to skip"
                }
              ]
            },
            "description": "Get all alerts with pagination"
          }
        },
        {
          "name": "Get Active Alerts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/alerts/active",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "alerts", "active"]
            },
            "description": "Get only active alerts"
          }
        },
        {
          "name": "Get Alert by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/alerts/:id",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "alerts", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "alert-id-here",
                  "description": "Alert ID"
                }
              ]
            },
            "description": "Get specific alert by ID"
          }
        },
        {
          "name": "Acknowledge Alert",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-id-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/alerts/:id/acknowledge",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "alerts", ":id", "acknowledge"],
              "variable": [
                {
                  "key": "id",
                  "value": "alert-id-here",
                  "description": "Alert ID"
                }
              ]
            },
            "description": "Acknowledge an alert"
          }
        },
        {
          "name": "Resolve Alert",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-id-here\",\n  \"notes\": \"Resolution notes\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/alerts/:id/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "alerts", ":id", "resolve"],
              "variable": [
                {
                  "key": "id",
                  "value": "alert-id-here",
                  "description": "Alert ID"
                }
              ]
            },
            "description": "Resolve an alert"
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "Get All Incidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents?status=&priority=&assignedTo=&limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents"],
              "query": [
                {
                  "key": "status",
                  "value": "",
                  "description": "Filter by status"
                },
                {
                  "key": "priority",
                  "value": "",
                  "description": "Filter by priority"
                },
                {
                  "key": "assignedTo",
                  "value": "",
                  "description": "Filter by assigned user"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of incidents to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Number of incidents to skip"
                }
              ]
            },
            "description": "Get all incidents with filters and pagination"
          }
        },
        {
          "name": "Get Active Incidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/active",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", "active"]
            },
            "description": "Get only active incidents"
          }
        },
        {
          "name": "Get Incident Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/stats",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", "stats"]
            },
            "description": "Get incident statistics"
          }
        },
        {
          "name": "Get Incident by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/:id",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "incident-id-here",
                  "description": "Incident ID"
                }
              ]
            },
            "description": "Get specific incident by ID"
          }
        },
        {
          "name": "Create Incident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Incident title\",\n  \"description\": \"Incident description\",\n  \"priority\": \"high\",\n  \"severity\": \"critical\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents"]
            },
            "description": "Create a new incident"
          }
        },
        {
          "name": "Assign Incident",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedTo\": \"user-id-here\",\n  \"assignedBy\": \"admin-id-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/:id/assign",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", ":id", "assign"],
              "variable": [
                {
                  "key": "id",
                  "value": "incident-id-here",
                  "description": "Incident ID"
                }
              ]
            },
            "description": "Assign an incident to a user"
          }
        },
        {
          "name": "Update Incident Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"updatedBy\": \"user-id-here\",\n  \"notes\": \"Status update notes\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": "incident-id-here",
                  "description": "Incident ID"
                }
              ]
            },
            "description": "Update incident status"
          }
        },
        {
          "name": "Resolve Incident",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolvedBy\": \"user-id-here\",\n  \"resolution\": \"Resolution description\",\n  \"rootCause\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/:id/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", ":id", "resolve"],
              "variable": [
                {
                  "key": "id",
                  "value": "incident-id-here",
                  "description": "Incident ID"
                }
              ]
            },
            "description": "Resolve an incident"
          }
        },
        {
          "name": "Add Post-Mortem",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postMortemNotes\": \"Post-mortem analysis notes\",\n  \"addedBy\": \"user-id-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/:id/post-mortem",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", ":id", "post-mortem"],
              "variable": [
                {
                  "key": "id",
                  "value": "incident-id-here",
                  "description": "Incident ID"
                }
              ]
            },
            "description": "Add post-mortem notes to an incident"
          }
        },
        {
          "name": "Close Incident",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"closedBy\": \"user-id-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/monitoring/incidents/:id/close",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "incidents", ":id", "close"],
              "variable": [
                {
                  "key": "id",
                  "value": "incident-id-here",
                  "description": "Incident ID"
                }
              ]
            },
            "description": "Close an incident"
          }
        }
      ]
    },
