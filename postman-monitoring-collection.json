    {
      "name": "Infrastructure",
      "item": [
        {
          "name": "Get Infrastructure Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/infrastructure/health",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "infrastructure", "health"]
            },
            "description": "System health status including API response time, error rate, and database health"
          }
        },
        {
          "name": "Get System Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/infrastructure/metrics?hours=24",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "infrastructure", "metrics"],
              "query": [
                {
                  "key": "hours",
                  "value": "24",
                  "description": "Number of hours of metrics to retrieve"
                }
              ]
            },
            "description": "System metrics trend over time"
          }
        }
      ]
    },
