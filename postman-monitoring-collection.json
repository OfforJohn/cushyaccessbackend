{
  "info": {
    "name": "Cushy Monitoring API",
    "description": "Monitoring module endpoints for Cushy backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Operations Dashboard",
      "item": [
        {
          "name": "Get Operations Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitoring/operations/overview",
              "host": ["{{baseUrl}}"],
              "path": ["monitoring", "operations", "overview"]
            },
            "description": "Overall operations summary with orders, riders, and stores metrics"
          }
        },
        {
          "name": "Get Order Metrics",
          "request": {
