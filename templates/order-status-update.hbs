<!--                                                    {{orderETA}}</td>-->
<!--                                            </tr>-->
                                            <tr>
                                                <td style="padding: 12px 0; font-weight: 600; color: #374151; font-family: Arial, sans-serif;">Created Date:</td>
                                                <td style="padding: 12px 0; color: #6b7280; font-family: Arial, sans-serif;">{{createdAt}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
