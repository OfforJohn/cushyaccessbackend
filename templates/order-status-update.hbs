                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">

                    
                    <!-- Main Content -->
                    <tr>
                        <td style="padding: 40px 30px;">
                            
                            <!-- Status Update Header -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 30px;">
                                <tr>
                                    <td align="center">
                                        <div style="background-color: #ddd6fe; border-radius: 50%; width: 80px; height: 80px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center;">
                                            <span style="font-size: 40px;">🚚</span>
                                        </div>
                                        <h2 style="font-size: 28px; color: #1f2937; margin: 0 0 10px 0; font-weight: 600; font-family: Arial, sans-serif;">Order Status Update</h2>
                                        <p style="font-size: 18px; color: #7c3aed; margin: 0; font-weight: 600; font-family: Arial, sans-serif;">Your order has been {{orderStatus}}!</p>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Order Summary -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #faf5ff; border: 2px solid #e9d5ff; border-radius: 12px; margin: 30px 0;">
                                <tr>
                                    <td style="padding: 25px;">
                                        <h3 style="font-size: 20px; color: #7c3aed; margin: 0 0 20px 0; font-weight: 600; font-family: Arial, sans-serif;">📦 Order Summary</h3>
                                        
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="padding: 12px 0; border-bottom: 1px solid #e9d5ff; font-weight: 600; color: #374151; width: 40%; font-family: Arial, sans-serif;">Order ID:</td>
                                                <td style="padding: 12px 0; border-bottom: 1px solid #e9d5ff; color: #6b7280; font-family: Arial, sans-serif;"><strong>#{{orderId}}</strong></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 12px 0; border-bottom: 1px solid #e9d5ff; font-weight: 600; color: #374151; font-family: Arial, sans-serif;">Current Status:</td>
                                                <td style="padding: 12px 0; border-bottom: 1px solid #e9d5ff; color: #6b7280; font-family: Arial, sans-serif;">
                                                    <span style="color: #000000; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">{{orderStatus}}</span>
                                                </td>
                                            </tr>
<!--                                            <tr>-->
<!--                                                <td style="padding: 12px 0; border-bottom: 1px solid #e9d5ff; font-weight: 600; color: #374151; font-family: Arial, sans-serif;">Estimated Processing:</td>-->
