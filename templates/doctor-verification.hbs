                <tr>
                  <td style="padding: 20px;">
                    <h4 style="font-size: 16px; color: #1e40af; margin: 0 0 15px 0; font-weight: 600;">🚀 What's Next?</h4>
                    <ul style="font-size: 14px; color: #3730a3; margin: 0; padding-left: 20px; line-height: 1.8;">
