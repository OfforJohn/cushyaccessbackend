                      </tr>
                      <tr>
                        <td style="padding: 10px 0; border-bottom: 1px solid #d1fae5; font-weight: 600; color: #374151;">Verified On:</td>
                        <td style="padding: 10px 0; border-bottom: 1px solid #d1fae5; color: #6b7280;">{{verificationDate}}</td>
                      </tr>
                      <tr>
                        <td style="padding: 10px 0; font-weight: 600; color: #374151;">Specialty:</td>
                        <td style="padding: 10px 0; color: #6b7280;">{{specialty}}</td>
                      </tr>
                    </table>
