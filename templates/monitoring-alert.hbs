<!doctype html>
<html lang="en">
	<body style="margin:0;padding:24px;background:#f3f6fb;font-family:Arial,Helvetica,sans-serif;color:#172033;">
		<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
			<tr>
				<td align="center">
					<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="max-width:600px;width:100%;background:#ffffff;border:1px solid #e3e8f0;border-radius:12px;overflow:hidden;">
						<tr>
							<td style="padding:28px 32px;background:#13233f;color:#ffffff;">
								<p style="margin:0 0 8px;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#a9c5f5;">Cushy Access · Operations</p>
								<h1 style="margin:0;font-size:24px;line-height:1.3;">Monitoring notification</h1>
								<p style="margin:8px 0 0;color:#d7e2f4;font-size:14px;">An update from your backend monitoring service</p>
							</td>
						</tr>
						<tr>
							<td style="padding:28px 32px;">
								{{#if isTest}}
								<div style="margin-bottom:22px;padding:14px 16px;border:1px solid #bfdbfe;border-radius:8px;background:#eff6ff;color:#1e40af;font-size:14px;line-height:1.5;">
									<strong>Test email — no incident was raised.</strong><br>
									This verifies that the application can send monitoring emails through Brevo.
								</div>
								{{/if}}

								<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:22px;background:#f8fafc;border:1px solid #e5eaf2;border-radius:8px;">
									<tr>
										<td style="padding:18px 20px;">
											<p style="margin:0 0 8px;color:#64748b;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">{{#if isTest}}Test summary{{else}}Alert details{{/if}}</p>
											<p style="margin:0;color:#172033;font-size:16px;line-height:1.6;">{{message}}</p>
										</td>
									</tr>
								</table>

								<h2 style="margin:0 0 12px;font-size:16px;color:#172033;">{{#if isTest}}Delivery check{{else}}Monitoring values{{/if}}</h2>
								<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:22px;border-collapse:collapse;">
									<tr>
										<td style="padding:12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;width:42%;">Current value</td>
										<td style="padding:12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;font-weight:bold;">{{currentValue}}</td>
									</tr>
									<tr>
										<td style="padding:12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;">Threshold</td>
										<td style="padding:12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;">{{thresholdValue}}</td>
									</tr>
								</table>

								<h2 style="margin:0 0 12px;font-size:16px;color:#172033;">Notification information</h2>
								<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
									<tr>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;width:42%;">Type</td>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;">{{type}}</td>
									</tr>
									<tr>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;">Severity</td>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;font-weight:bold;">{{severity}}</td>
									</tr>
									<tr>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;">Status</td>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;">{{status}}</td>
									</tr>
									<tr>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;">Alert reference</td>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;">{{alertId}}</td>
									</tr>
									<tr>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;">Created at</td>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;">{{createdAt}}</td>
									</tr>
									{{#if recipient}}
									<tr>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#64748b;font-size:13px;">Sent to</td>
										<td style="padding:10px 12px;border:1px solid #e5eaf2;color:#172033;font-size:14px;">{{recipient}}</td>
									</tr>
									{{/if}}
								</table>

								{{#if isTest}}
								<p style="margin:20px 0 0;color:#64748b;font-size:13px;line-height:1.6;">A successful response means Brevo accepted the message for delivery. It does not guarantee inbox placement; check spam or mail filtering if you do not see it.</p>
								{{else}}
								<p style="margin:20px 0 0;color:#64748b;font-size:13px;line-height:1.6;">Review the monitoring dashboard and follow your incident response process if action is required.</p>
								{{/if}}
							</td>
						</tr>
						<tr>
							<td style="padding:16px 32px;background:#f8fafc;border-top:1px solid #e5eaf2;color:#94a3b8;font-size:12px;line-height:1.5;">
								Automated notification from Cushy Access monitoring. Please do not reply to this email.
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>