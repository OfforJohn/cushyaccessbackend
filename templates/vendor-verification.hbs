<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vendor Verification - CushyAccess</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa; font-family: Arial, sans-serif;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f8f9fa;">
    <tr>
      <td align="center" style="padding: 20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
          <tr>
            <td style="padding: 40px 30px;">

              <div style="text-align: center; margin-bottom: 30px;">
                {{#if (eq status "APPROVED")}}
                  <div style="width: 80px; height: 80px; background-color: #ecfdf5; border-radius: 50%; margin: 0 auto 20px auto; display: flex; align-items: center; justify-content: center;">
                    <span style="font-size: 40px; line-height: 80px;">✅</span>
                  </div>
                  <h2 style="font-size: 28px; color: #1f2937; margin: 0; font-weight: 600;">Congratulations! You're Verified 🎉</h2>
                {{else}}
                  <div style="width: 80px; height: 80px; background-color: #fef2f2; border-radius: 50%; margin: 0 auto 20px auto; display: flex; align-items: center; justify-content: center;">
                    <span style="font-size: 40px; line-height: 80px;">❌</span>
                  </div>
                  <h2 style="font-size: 28px; color: #1f2937; margin: 0; font-weight: 600;">Verification Unsuccessful</h2>
                {{/if}}
              </div>

              <p style="font-size: 16px; color: #4b5563; line-height: 1.6; margin-bottom: 30px;">
                Hello <strong>{{vendorName}}</strong>,<br><br>
                {{#if (eq status "APPROVED")}}
                  Great news! Your vendor account has been successfully verified. You're now ready to start selling on CushyAccess!
                {{else}}
                  Thank you for submitting your verification details. Unfortunately, your verification request has been rejected at this time.
                {{/if}}
              </p>

              {{#unless (eq status "APPROVED")}}
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #fff5f5; border-left: 4px solid #ef4444; margin: 20px 0;">
                  <tr>
                    <td style="padding: 20px;">
                      <h4 style="font-size: 16px; color: #991b1b; margin: 0 0 10px 0; font-weight: 600;">⚠️ Reason for Rejection:</h4>
                      <p style="font-size: 14px; color: #b91c1c; margin: 0; line-height: 1.5;">
                        {{rejectionReason}}
                      </p>
                    </td>
                  </tr>
                </table>
              {{/unless}}

              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" 
                     style="border-radius: 12px; margin: 20px 0; 
                            {{#if (eq status "APPROVED")}} background-color: #ecfdf5; border: 2px solid #6ee7b7; {{else}} background-color: #f9fafb; border: 2px solid #e5e7eb; {{/if}}">
                <tr>
                  <td style="padding: 25px;">
                    <h3 style="font-size: 20px; margin: 0 0 20px 0; font-weight: 600; {{#if (eq status "APPROVED")}} color: #059669; {{else}} color: #4b5563; {{/if}}">🏪 Verification Details</h3>

                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                      <tr>
                        <td style="padding: 10px 0; font-weight: 600; color: #374151; width: 40%; {{#if (eq status "APPROVED")}} border-bottom: 1px solid #d1fae5; {{else}} border-bottom: 1px solid #e5e7eb; {{/if}}">Store Name:</td>
                        <td style="padding: 10px 0; color: #6b7280; {{#if (eq status "APPROVED")}} border-bottom: 1px solid #d1fae5; {{else}} border-bottom: 1px solid #e5e7eb; {{/if}}">{{storeName}}</td>
                      </tr>
                      <tr>
                        <td style="padding: 10px 0; font-weight: 600; color: #374151; {{#if (eq status "APPROVED")}} border-bottom: 1px solid #d1fae5; {{else}} border-bottom: 1px solid #e5e7eb; {{/if}}">Status:</td>
                        <td style="padding: 10px 0; {{#if (eq status "APPROVED")}} border-bottom: 1px solid #d1fae5; color: #10b981; {{else}} border-bottom: 1px solid #e5e7eb; color: #ef4444; {{/if}}">
                          <strong>{{#if (eq status "APPROVED")}}✓ Verified{{else}}✗ Rejected{{/if}}</strong>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding: 10px 0; font-weight: 600; color: #374151; {{#if (eq status "APPROVED")}} border-bottom: 1px solid #d1fae5; {{else}} border-bottom: 1px solid #e5e7eb; {{/if}}">Processed On:</td>
                        <td style="padding: 10px 0; color: #6b7280; {{#if (eq status "APPROVED")}} border-bottom: 1px solid #d1fae5; {{else}} border-bottom: 1px solid #e5e7eb; {{/if}}">{{verificationDate}}</td>
                      </tr>
                      <tr>
                        <td style="padding: 10px 0; font-weight: 600; color: #374151;">Category:</td>
                        <td style="padding: 10px 0; color: #6b7280;">{{storeCategory}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              {{#if (eq status "APPROVED")}}
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #eff6ff; border-left: 4px solid #3b82f6; margin: 30px 0;">
                  <tr>
                    <td style="padding: 20px;">
                      <h4 style="font-size: 16px; color: #1e40af; margin: 0 0 15px 0; font-weight: 600;">🚀 What's Next?</h4>
                      <ul style="font-size: 14px; color: #3730a3; margin: 0; padding-left: 20px; line-height: 1.8;">
                        <li>Add products to your store catalog</li>
                        <li>Set up your payment details to receive earnings</li>
                        <li>Configure your delivery options</li>
                        <li>Start receiving orders from customers</li>
                      </ul>
                    </td>
                  </tr>
                </table>
                <p style="font-size: 16px; color: #4b5563; line-height: 1.6; margin-top: 30px;">
                  As a verified vendor, you now have access to all seller features including real-time order tracking, customer insights, and promotional tools.
                </p>
              {{else}}
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; margin: 30px 0;">
                  <tr>
                    <td style="padding: 20px;">
                      <h4 style="font-size: 16px; color: #78350f; margin: 0 0 15px 0; font-weight: 600;">🔄 How to Re-apply:</h4>
                      <ul style="font-size: 14px; color: #92400e; margin: 0; padding-left: 20px; line-height: 1.8;">
                        <li>Review the rejection reason outlined above carefully.</li>
                        <li>Log back into your account on the CushyAccess Mobile App.</li>
                        <li>Update or re-upload clear, valid documents in your profile configuration.</li>
                        <li>Resubmit your profile details for verification assessment.</li>
                      </ul>
                    </td>
                  </tr>
                </table>
              {{/if}}

              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 30px 0;">
                <tr>
                  <td align="center">
                    <a href="cushyaccess://" 
                       style="display: inline-block; color: #ffffff; text-decoration: none; padding: 14px 40px; border-radius: 8px; font-size: 16px; font-weight: 600; 
                              {{#if (eq status "APPROVED")}} background-color: #10b981; {{else}} background-color: #4b5563; {{/if}}">
                      {{#if (eq status "APPROVED")}}Open Cushy Access App{{else}}Review Details in App{{/if}}
                    </a>
                    <p style="font-size: 12px; color: #6b7280; margin-top: 10px;">
                      If the app doesn't open, <a href="https://play.google.com/store/apps/details?id=com.cushyaccess.app" style="color: #a855f7;">download on Android</a> or 
                      <a href="https://apps.apple.com/app/id6755833733" style="color: #a855f7;">iOS</a>
                    </p>                  
                  </td>
                </tr>
              </table>

              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #fef3c7; border-left: 4px solid #f59e0b; margin: 30px 0;">
                <tr>
                  <td style="padding: 20px;">
                    <h4 style="font-size: 16px; color: #92400e; margin: 0 0 10px 0; font-weight: 600;">💬 Need Help Getting Started?</h4>
                    <p style="font-size: 14px; color: #a16207; margin: 0;">
                      Our vendor support team is here to help you succeed. Reach out at <strong>support@cushyaccess.com</strong> or call <strong>+234 707 120 0299</strong>.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <tr>
            <td style="background-color: #1f2937; padding: 30px 20px; text-align: center; border-radius: 0 0 8px 8px;">
              <p style="color: #ffffff; font-size: 18px; font-weight: 600; margin: 0 0 10px 0; font-family: Arial, sans-serif;">CushyAccess</p>
              <p style="color: #9ca3af; font-size: 14px; margin: 0 0 20px 0; font-family: Arial, sans-serif;">Your Trusted Logistics Partner</p>
              <p style="color: #9ca3af; font-size: 14px; margin: 0 0 20px 0; font-family: Arial, sans-serif;">Empowering e-commerce businesses with seamless delivery solutions</p>
              
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 20px 0;">
                <tr>
                  <td align="center">
                    <a href="https://cushyaccess.com/support/" style="color: #a855f7; text-decoration: none; margin: 0 15px; font-family: Arial, sans-serif;">Support Center</a>
                    <a href="https://wa.link/jwg3s5" style="color: #a855f7; text-decoration: none; margin: 0 15px; font-family: Arial, sans-serif;">Contact Us</a>
                  </td>
                </tr>
              </table>
              
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 20px 0;">
                <tr>
                  <td align="center">
                    <a href="#" style="color: #6b7280; text-decoration: none; margin: 0 10px; font-family: Arial, sans-serif;">LinkedIn</a>
                    <a href="https://x.com/cushy_access" style="color: #6b7280; text-decoration: none; margin: 0 10px; font-family: Arial, sans-serif;">Twitter</a>
                    <a href="https://facebook.com/cushyaccess" style="color: #6b7280; text-decoration: none; margin: 0 10px; font-family: Arial, sans-serif;">Facebook</a>
                  </td>
                </tr>
              </table>

              <p style="margin-top: 20px; font-size: 12px; color: #6b7280; font-family: Arial, sans-serif;">
                © 2026 CushyAccess. All rights reserved.<br>
                Tunga Roundabout, Minna Niger State, Nigeria.<br>
                <a href="#" style="color: #a855f7; text-decoration: none;">Unsubscribe</a> |
                <a href="https://cushyaccess.com/privacy/" style="color: #a855f7; text-decoration: none;">Privacy Policy</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>