<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wallet Debit - CushyAccess</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f8f9fa; font-family: Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="background-color: #f8f9fa;">
        <tr>
            <td align="center" style="padding: 20px 0;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600"
                    style="max-width: 600px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                    <tr>
                        <td style="padding: 40px 30px;">

                            <!-- Header -->
                            <h2 style="font-size: 28px; color: #1f2937; margin: 0 0 20px 0; font-weight: 600;">Wallet
                                Debit Notification 📤</h2>

                            <!-- Greeting -->
                            <p style="font-size: 16px; color: #4b5563; line-height: 1.6; margin-bottom: 30px;">
                                Hello <strong>{{recipientName}}</strong>,<br>
                                We're writing to inform you that a debit has been made from your CushyAccess wallet.
                                Here are the details:
                            </p>

                            <!-- Debit Details Card -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                                style="background-color: #fef2f2; border: 2px solid #fca5a5; border-radius: 12px; margin: 20px 0;">
                                <tr>
                                    <td style="padding: 25px;">
                                        <h3
                                            style="font-size: 20px; color: #dc2626; margin: 0 0 20px 0; font-weight: 600;">
                                            💳 Debit Details</h3>

                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0"
                                            width="100%">
                                            <tr>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; font-weight: 600; color: #374151; width: 40%;">
                                                    Amount Debited:</td>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; color: #dc2626;">
                                                    <strong>₦{{amount}}</strong></td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; font-weight: 600; color: #374151;">
                                                    Reason:</td>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; color: #6b7280;">
                                                    {{reason}}</td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; font-weight: 600; color: #374151;">
                                                    Reference:</td>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; color: #6b7280;">
                                                    {{reference}}</td>
                                            </tr>
                                            <tr>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; font-weight: 600; color: #374151;">
                                                    New Balance:</td>
                                                <td
                                                    style="padding: 10px 0; border-bottom: 1px solid #fecaca; color: #374151;">
                                                    <strong>₦{{newBalance}}</strong></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 10px 0; font-weight: 600; color: #374151;">Date:
                                                </td>
                                                <td style="padding: 10px 0; color: #6b7280;">{{date}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <p style="font-size: 16px; color: #4b5563; line-height: 1.6; margin-top: 30px;">
                                This debit was processed by our administrative team. If you have any questions or
                                concerns about this action, please don't hesitate to contact our support team.
                            </p>

                            <!-- Support Section -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                                style="background-color: #fef3c7; border-left: 4px solid #f59e0b; margin: 30px 0;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <h4
                                            style="font-size: 16px; color: #92400e; margin: 0 0 10px 0; font-weight: 600;">
                                            💬 Need Help?</h4>
                                        <p style="font-size: 14px; color: #a16207; margin: 0;">
                                            If you have any questions about this transaction, feel free to reach out to
                                            us at <strong>support@cushyaccess.com</strong> or call <strong>+234 707 120
                                                0299</strong>.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <!-- Footer -->
                    <tr>
                        <td
                            style="background-color: #1f2937; padding: 30px 20px; text-align: center; border-radius: 0 0 8px 8px;">
                            <p
                                style="color: #ffffff; font-size: 18px; font-weight: 600; margin: 0 0 10px 0; font-family: Arial, sans-serif;">
                                CushyAccess</p>
                            <p
                                style="color: #9ca3af; font-size: 14px; margin: 0 0 20px 0; font-family: Arial, sans-serif;">
                                Your Trusted Logistics Partner</p>
                            <p
                                style="color: #9ca3af; font-size: 14px; margin: 0 0 20px 0; font-family: Arial, sans-serif;">
                                Empowering e-commerce businesses with seamless delivery solutions</p>

                            <!-- Footer Links -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                                style="margin: 20px 0;">
                                <tr>
                                    <td align="center">
                                        <!--                                        <a href="#" style="color: #a855f7; text-decoration: none; margin: 0 15px; font-family: Arial, sans-serif;">Dashboard</a>-->
                                        <a href="https://cushyaccess.com/support/"
                                            style="color: #a855f7; text-decoration: none; margin: 0 15px; font-family: Arial, sans-serif;">Support
                                            Center</a>

                                        <a href="https://wa.link/jwg3s5"
                                            style="color: #a855f7; text-decoration: none; margin: 0 15px; font-family: Arial, sans-serif;">Contact
                                            Us</a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Social Links -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                                style="margin: 20px 0;">
                                <tr>
                                    <td align="center">
                                        <a href="#"
                                            style="color: #6b7280; text-decoration: none; margin: 0 10px; font-family: Arial, sans-serif;">LinkedIn</a>
                                        <a href="https://x.com/cushy_access"
                                            style="color: #6b7280; text-decoration: none; margin: 0 10px; font-family: Arial, sans-serif;">Twitter</a>
                                        <a href="https://facebook.com/cushyaccess"
                                            style="color: #6b7280; text-decoration: none; margin: 0 10px; font-family: Arial, sans-serif;">Facebook</a>
                                    </td>
                                </tr>
                            </table>

                            <p
                                style="margin-top: 20px; font-size: 12px; color: #6b7280; font-family: Arial, sans-serif;">
                                © 2026 CushyAccess. All rights reserved.<br>
                                Tunga Roundabout, Minna Niger State, Nigeria.<br>
                                <a href="#" style="color: #a855f7; text-decoration: none;">Unsubscribe</a> |
                                <a href="https://cushyaccess.com/privacy/"
                                    style="color: #a855f7; text-decoration: none;">Privacy Policy</a>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>


</html>

