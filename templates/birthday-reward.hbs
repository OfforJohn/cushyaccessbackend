<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your Cushy Access birthday reward</title>
  </head>
  <body
    style='margin: 0; padding: 0; background-color: #f7f2f8; font-family: Arial, Helvetica, sans-serif; color: #2d2430;'
  >
    <div
      style='display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;'
    >
      Happy birthday! Your
      {{discountPercentage}}% Cushy Access reward is ready.
    </div>

    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      border='0'
    >
      <tr>
        <td align='center' style='padding: 24px 12px;'>
          <table
            role='presentation'
            width='600'
            cellspacing='0'
            cellpadding='0'
            border='0'
            style='width: 100%; max-width: 600px; background-color: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 8px 28px rgba(78, 30, 88, 0.12);'
          >
            <tr>
              <td
                align='center'
                style='padding: 20px 24px 16px; background-color: #ffffff;'
              >
                <img
                  src='{{assetBaseUrl}}/email-assets/cushy-icon.png'
                  width='80'
                  alt='Cushy Access'
                  style='display: block; width: 80px; max-width: 80px; height: auto; border: 0;'
                />
                <div
                  style='margin-top: 5px; color: #4e1e58; font-size: 20px; font-weight: 700;'
                >
                  Cushy Access
                </div>
              </td>
            </tr>

            <tr>
              <td>
                <img
                  src='{{assetBaseUrl}}/email-assets/birthday-hero.jpg'
                  width='600'
                  alt='A birthday cake and gifts in Cushy Access colours'
                  style='display: block; width: 100%; max-width: 600px; height: auto; border: 0;'
                />
              </td>
            </tr>

            <tr>
              <td style='padding: 36px 34px 12px; text-align: center;'>
                <p
                  style='margin: 0 0 8px; color: #a65b00; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;'
                >
                  A little birthday love from us
                </p>
                <h1
                  style='margin: 0; color: #4e1e58; font-size: 30px; line-height: 1.25;'
                >
                  Happy birthday,
                  {{firstName}}!
                </h1>
                <p
                  style='margin: 18px auto 0; max-width: 470px; color: #5f5662; font-size: 16px; line-height: 1.65;'
                >
                  Today is about you. We hope it brings good food, happy
                  moments, and plenty of reasons to smile. Here is a special
                  treat for your next Cushy Access order.
                </p>
              </td>
            </tr>

            <tr>
              <td style='padding: 18px 34px;'>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  border='0'
                  style='background: #fbf3dc; border: 1px solid #f2d797; border-radius: 14px;'
                >
                  <tr>
                    <td align='center' style='padding: 25px 18px;'>
                      <div
                        style='color: #4e1e58; font-size: 28px; font-weight: 800;'
                      >
                        {{discountPercentage}}% OFF
                      </div>
                      <div
                        style='margin-top: 6px; color: #6d626f; font-size: 14px;'
                      >
                        One-time birthday reward on eligible items
                      </div>
                      <div
                        style="margin: 18px auto 10px; padding: 14px 18px; background-color: #ffffff; border: 2px dashed #7a3b82; border-radius: 10px; color: #4e1e58; font-family: 'Courier New', monospace; font-size: 22px; font-weight: 700; letter-spacing: 1.5px; word-break: break-all;"
                      >
                        {{code}}
                      </div>
                      <div
                        style='color: #6d626f; font-size: 13px; line-height: 1.5;'
                      >
                        Use once before
                        <strong>{{expiresAtFormatted}} (WAT)</strong>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td align='center' style='padding: 10px 34px 38px;'>
                <p
                  style='margin: 0 0 20px; color: #5f5662; font-size: 15px; line-height: 1.6;'
                >
                  Copy the code, open the Cushy Access app, and apply it at
                  checkout. Your reward is also saved to your account, so this
                  email is your handy backup if the birthday notification
                  disappears.
                </p>
                <a
                  href='https://cushyaccess.com/'
                  style='display: inline-block; padding: 15px 28px; background-color: #4e1e58; border-radius: 10px; color: #ffffff; font-size: 16px; font-weight: 700; text-decoration: none;'
                >Start your birthday order</a>
              </td>
            </tr>

            <tr>
              <td
                align='center'
                style='padding: 24px; background-color: #4e1e58;'
              >
                <p
                  style='margin: 0 0 8px; color: #ffffff; font-size: 15px; font-weight: 700;'
                >
                  With love, the Cushy Access team
                </p>
                <p
                  style='margin: 0; color: #ddcde1; font-size: 12px; line-height: 1.6;'
                >
                  Need help? Visit
                  <a
                    href='https://cushyaccess.com/support/'
                    style='color: #ffcf73; text-decoration: none;'
                  >Cushy Support</a>
                  or email
                  <a
                    href='mailto:support@cushyaccess.com'
                    style='color: #ffcf73; text-decoration: none;'
                  >support@cushyaccess.com</a>.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>