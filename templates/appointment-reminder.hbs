<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Appointment Reminder - Cushy Access</title>
</head>
<body style="margin:0; padding:0; background:#f7f7fb; font-family:Arial, sans-serif; color:#24212a;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background:#ffffff; border-radius:10px; overflow:hidden;">
          <tr>
            <td style="background:#4e1e58; color:#ffffff; padding:28px 30px; text-align:center;">
              <h1 style="margin:0; font-size:24px; line-height:1.3;">{{headline}}</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 30px;">
              <p style="font-size:16px; margin:0 0 14px;">Hello <strong>{{recipientName}}</strong>,</p>
              <p style="font-size:15px; line-height:1.6; color:#4b5563; margin:0 0 22px;">{{intro}}</p>

              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#faf7fb; border:1px solid #eadfec; border-radius:8px; margin-bottom:22px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 10px;"><strong>{{counterpartLabel}}:</strong> {{counterpartName}}</p>
                    <p style="margin:0 0 10px;"><strong>Date:</strong> {{appointmentDate}}</p>
                    <p style="margin:0 0 10px;"><strong>Time:</strong> {{appointmentTime}}</p>
                    <p style="margin:0 0 10px;"><strong>Duration:</strong> {{duration}}</p>
                    <p style="margin:0;"><strong>Consultation Type:</strong> {{consultationType}}</p>
                  </td>
                </tr>
              </table>

              <p style="font-size:14px; line-height:1.6; color:#4b5563; margin:0 0 18px;">
                The call button will be available in the app when it is time for the consultation.
              </p>

              {{#if meetingLink}}
              <p style="font-size:13px; line-height:1.5; color:#6b7280; margin:0;">
                Meeting reference: {{meetingLink}}
              </p>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td style="background:#f3f4f6; padding:16px 30px; text-align:center; color:#6b7280; font-size:12px;">
              &copy; {{currentYear}} Cushy Access. All rights reserved.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
