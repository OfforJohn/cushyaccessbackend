{
  "info": {
    "_postman_id": "riders-api-collection",
    "name": "Riders Registration & Login API",
    "description": "Postman collection for testing Rider Registration, Login, Password Setup, and Identity Verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Rider",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"phone\": \"+1234567890\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"identity_number\": \"ID123456789\",\n  \"identity_document_url\": \"https://example.com/documents/id.jpg\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/riders/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "riders",
            "register"
          ]
        },
        "description": "Register a new rider with first name, last name, phone number, password, and optional identity information"
      },
      "response": []
    },
    {
      "name": "Set Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"SecurePassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/riders/set-password?id={{rider_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "riders",
            "set-password"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{rider_id}}"
            }
          ]
        },
        "description": "Update password for a rider (optional - only needed if changing password after registration). Requires authentication token."
      },
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"+1234567890\",\n  \"password\": \"SecurePassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/riders/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "riders",
            "login"
          ]
        },
        "description": "Login using phone number as username and the password set during registration. Returns JWT access token."
      },
      "response": []
    },
    {
      "name": "Verify Identity",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/riders/verify?id={{rider_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "riders",
            "verify"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{rider_id}}"
            }
          ]
        },
        "description": "Verify the identity of a rider (Admin endpoint). Changes status to VERIFIED."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "rider_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ]
}
